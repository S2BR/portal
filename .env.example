# ─── S2BR Portal (web) — environment ────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values. Never commit secrets.

# Portal API base URL (includes the /v1 version segment).
PORTAL_API_URL=https://portal.s2br.com/api/v1

# Secret used to sign/encrypt session cookies. REQUIRED in production.
# Generate one with:  openssl rand -base64 48
SESSION_COOKIE_SECRET=

# ─── Access-token verification (security-critical) ──────────────────────────
# The BFF verifies every access token's RS256 signature against this PINNED
# public key — plus audience, issuer, and expiry — BEFORE it establishes a
# session, so a forged, MITM'd, or misrouted response can never mint one. These
# MUST match the portal that PORTAL_API_URL points at; without the public key,
# sign-in fails closed.
#
# The portal's JWT public key (PEM) on a single line, newlines written as \n:
PORTAL_JWT_PUBLIC_KEY=
# The portal's token issuer — its APP_URL, e.g. https://portal.s2br.com:
PORTAL_JWT_ISSUER=
# The token audience (the portal's JWT_AUDIENCE):
PORTAL_JWT_AUDIENCE=s2br-app

# ─── Analytics (optional) ───────────────────────────────────────────────────
# Google Analytics 4 Measurement ID. Public (it ships in the page), but kept in
# env so it's per-environment and analytics stay off when unset. Loaded behind a
# consent banner via Consent Mode v2 (default-denied until the visitor accepts).
NEXT_PUBLIC_GA_ID=

# ─── UI ─────────────────────────────────────────────────────────────────────
# Theme-toggle wipe blur. Public (it drives a client animation), baked in at
# build time — changing it needs a rebuild/redeploy.
#   new  — only the incoming theme blurs in as it wipes (default when unset)
#   both — incoming blurs in AND the outgoing theme blurs out (fuller crossfade)
NEXT_PUBLIC_THEME_BLUR_MODE=new

# How many reviews the public reviews list auto-loads via infinite scroll before it switches to a
# manual "Show more" button (caps unbounded background fetching). The list pages 15 at a time, so a
# multiple of 15 lands cleanly. Inlined at build time; defaults to 120 when unset.
NEXT_PUBLIC_REVIEWS_AUTOLOAD_LIMIT=120
